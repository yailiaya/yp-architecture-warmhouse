@startuml
title Warmhouse Telemetry Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(TelemetryService, "Telemetry Service") {
  Component(MQTTHandler, "MQTT Messages Handler", "MQTT Broker",  "MQTT Protocol")
  Component(DeviceStatusValidator, "Device Status Validator", "Validatge device and its status - registered, active etc.")
  Component(ElasticsearchConverter, "MQTT to Elasticsearch converter", ".Net", "Converts and makes messages valid for Elasticsearch")
  Component(ElasticsearchConnector, "MQTT Connector to Elasticsearch", ".Net", "MQTT to Elasticsearch")
}

Container(StoreService, "ELK", "Elasticsearch + Logstash + Kibana", "Store and index logs and telemetry")
System_Ext(Device, "Device", "Standart protocol", "External device on user site")

Rel(Device,MQTTHandler,"Sends telemetry via MQTT protocol")
Rel(MQTTHandler,DeviceStatusValidator,"Receives data")
Rel(DeviceStatusValidator,ElasticsearchConverter,"Receives data")
Rel(ElasticsearchConverter,ElasticsearchConnector,"Convert data")
Rel(ElasticsearchConnector,StoreService,"Writes data")

@enduml