@startuml

' Entities
entity "User" as user {
  *id: int <*>
  name: varchar
  email: varchar
  phone: varchar
}

entity "Home" as home {
  *id: int <*>
  user_id: int
  adress: varchar
  zipcode: int
  total: decimal
}

entity "Device" as device {
  *id: int <*>
  home_id: int
  devicetype_id: int
  serialnumber: varchar
  location: varchar
  type: int
  status: int
}

entity "DeviceType" as device_type {
  *id: int <*>
  descrtption: varchar
}

entity "Device Model" as device_model {
  *id: int <*>
  devicetype_id: int
  specs: varchar
}

entity "Device Status" as device_status {
  *id: int <*>
  description: varchar
}

entity "Telemetry" as telemetry_record {
  *id: int <*>
  device_id: int
  date: date
  data: string
}

entity "Parameter" as parameter {
  *id:              int <*>
  parameter_type:   int
  value:            varchar
}

entity "Action" as action {
  *id: int <*>
  name: varchar
  parameter: int
}

entity "Expression" as expression {
  *id: int <*>
  device_id: int
  condition_id: int
  parameter_id: int
  parameter_value: varchar
}

entity "Condition" as condition {
  *id: int <*>
  name: varchar
  parameter_id: int
  condition_type: int
  value: varchar
}

' Relations
user ||--o{ home : "создаёт"
user ||--o{ device : "создаёт"
home ||--|| device : "принадлежит"
device ||--|| device_type : "является"
device ||--|| device_model : "является"
device ||--o{ device_status : "является"
device ||--o{ telemetry_record : "логгирует"
device ||--|| device_configuration : "содержит"
device_configuration ||--o{ action : "управляет"
action ||--o{ parameter : "принадлежит"
device ||--o{ expression : "ссылается"
expression ||--o{ condition : "ссылается"

@enduml